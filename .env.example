# Local fixture. Set your own random value (at least 24 characters).
AUTH_MODE=local
LOCAL_ADMIN_PASSWORD=
ATLAS_DATA_DIR=.atlas
# Optional Meta Unified Login token for direct Instagram publishing.
# INSTAGRAM_ACCESS_TOKEN=
# Default: SQLite + filesystem. Vite reads this file in development.
# DATABASE_URL=Server=...;Database=...;Encrypt=true;Authentication=Active Directory Integrated
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# AZURE_STORAGE_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=atlas
# For trusted Azure Container Apps ingress only:
# AUTH_MODE=entra
# ENTRA_TENANT_ID=
# ENTRA_ADMIN_OBJECT_ID=
# ORIGIN=https://...
# BODY_SIZE_LIMIT=26M
